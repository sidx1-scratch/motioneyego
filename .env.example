# Server Configuration
PORT=3000
HOST=0.0.0.0

# MotionEye or Frigate Stream URLs (comma-separated)
# Format: NAME|URL,NAME|URL
# Smart URL Conversion: You can paste MotionEye links or Frigate UI links!
# E.g. http://192.168.0.87:5000/#camera_1 automatically converts to http://192.168.0.87:5000/api/camera_1
STREAMS=Driveway|http://192.168.1.100:8081,FrontDoor|http://192.168.0.87:5000/#camera_1,Backyard|http://192.168.1.100:8083,Garage|http://192.168.1.100:8084

# MotionEye Server (for API access)
MOTIONEYE_URL=http://192.168.1.100:8765
MOTIONEYE_USERNAME=admin
MOTIONEYE_PASSWORD=

# Frigate NVR Configuration
FRIGATE_URL=http://192.168.1.100:5000
FRIGATE_ENABLED=false
